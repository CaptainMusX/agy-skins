{
  "name": "agy-skins",
  "version": "2.1.4",
  "description": "Wallpaper Engine (Scene, Web, video and Picture) live backdrop, liquid glass, typography, click/trail FX and 3D parallax plugin for Google Antigravity",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js",
    "install:agy": "node scripts/install.mjs",
    "uninstall:agy": "node scripts/uninstall.mjs",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "keywords": [
    "antigravity",
    "agy",
    "wallpaper-engine",
    "liquid-glass",
    "theme",
    "sidecar"
  ],
  "author": "CaptainMusX",
  "license": "SEE LICENSE IN LICENSING.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/CaptainMusX/agy-skins.git"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
